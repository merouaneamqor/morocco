---
/**
 * A country's holdings.
 *
 * This is the Moroccan/Spanish archival layer: no new taxonomy, just the
 * Country field the corpus already carries, given its own route so that
 * "what does Spain hold on this" is one click rather than a filter.
 *
 * The route lives under /archives/country/ rather than /archives/<country>
 * so it can never collide with an institution slug.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { countrySlug } from '../../../lib/country-slug.mjs';

export async function getStaticPaths() {
  const archives = (await getCollection('archives')).map((a) => a.data);
  const countries = [...new Set(archives.map((a) => a.country))];
  return countries.map((country) => ({
    params: { country: countrySlug(country) },
    props: { country, rows: archives.filter((a) => a.country === country) },
  }));
}

const { country, rows } = Astro.props;

const PRIORITY_ORDER = ['1 - decisive', '2 - structural', '3 - supporting', '4 - background'];
const sorted = [...rows].sort(
  (a, b) =>
    PRIORITY_ORDER.indexOf(a.priority) - PRIORITY_ORDER.indexOf(b.priority) ||
    a.institution.localeCompare(b.institution)
);

const withPlan = rows.filter((a) => a.notYetSearched).length;
const languages = [...new Set(rows.flatMap((a) => a.language))].sort();
---

<Base
  title={`Archives — ${country}`}
  description={`Holdings in ${country} that bear on Moroccan history, with what each can settle and what remains unsearched.`}
>
  <p class="kicker"><a href="/archives">Archives</a></p>
  <h1>{country}</h1>

  <p class="lede">
    {rows.length} holding{rows.length === 1 ? '' : 's'}
    {languages.length > 0 && <> · {languages.join(' · ')}</>}
    · {withPlan} with a recorded search plan
  </p>

  <ul class="rows">
    {
      sorted.map((a) => (
        <li>
          <div class="rows__head">
            <a href={`/archives/${a.slug}`}>{a.institution}</a>
            <span class="rows__pri">{a.priority}</span>
          </div>
          {a.city && <p class="rows__city">{a.city}</p>}
          {a.whatItCanSettle && <p class="rows__settle">{a.whatItCanSettle}</p>}
          <p class={a.notYetSearched ? 'rows__backlog' : 'rows__backlog rows__backlog--none'}>
            <span class="rows__backloglabel">Not yet searched</span>
            {a.notYetSearched ?? 'Not yet documented'}
          </p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .kicker {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 var(--s-2);
  }

  .lede {
    max-width: var(--measure);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-secondary);
    padding-bottom: var(--s-3);
    border-bottom: 2px solid var(--baseline);
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--measure);
  }

  .rows li {
    padding: var(--s-4) 0;
    border-bottom: var(--rule);
  }

  .rows__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .rows__pri {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .rows__city,
  .rows__settle {
    margin: var(--s-2) 0 0;
    font-size: 0.9rem;
    line-height: var(--leading);
  }

  .rows__city {
    color: var(--ink-muted);
    font-size: 0.8rem;
  }

  .rows__backlog {
    margin: var(--s-3) 0 0;
    font-size: 0.85rem;
    line-height: var(--leading);
    color: var(--ink-secondary);
  }

  .rows__backloglabel {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .rows__backlog--none {
    color: var(--ink-muted);
    font-style: italic;
  }
</style>

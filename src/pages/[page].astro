---
/**
 * The long-form argumentative pages.
 *
 * These are the spine of the corpus and they are rendered as essays with a
 * sticky table of contents — never chopped into cards. Their heavy table use
 * is preserved, with each table scrolling inside its own container so the page
 * body never scrolls sideways.
 */
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CorpusDrift from '../components/CorpusDrift.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((p) => ({
    params: { page: p.data.slug },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

/**
 * The synthesis states the Moroccan-side documentary base is zero. That was
 * accurate when written; the Sources database has since moved. Rather than
 * editing the essay, count the Arabic-language sources now present and let the
 * reader see both. The count is computed, not asserted, so it self-corrects.
 */
const sources = await getCollection('sources');
const arabicSources = sources.filter((s) => s.data.language.includes('Arabic'));
const moroccanAuthored = arabicSources.filter((s) =>
  ['PRIMARY_ARCHIVAL', 'PRIMARY_CONTEMPORARY', 'OFFICIAL'].includes(s.data.tier)
);
const showDrift = entry.data.slug === 'synthesis' && moroccanAuthored.length > 0;
---

<Base title={entry.data.title} description={entry.data.lede}>
  <div class="longform">
    <article class="longform__body prose">
      <header class="longform__head">
        {entry.data.icon && <p class="longform__icon" aria-hidden="true">{entry.data.icon}</p>}
        <h1>{entry.data.title}</h1>
      </header>
      <Content />

      {
        showDrift && (
          <CorpusDrift
            claim="“The Moroccan-side documentary base is currently zero.” Every dossier describes Moroccan actors substantially through European reporting about them."
            observation={`The Sources database now holds ${arabicSources.length} Arabic-language sources, ${moroccanAuthored.length} of them at primary or official tier — including al-Nasiri's Kitāb al-Istiqsā, the first comprehensive national history of Morocco, and the HCAR resistance cahiers, which carry the first Moroccan-side documentary treatment of El Herri.`}
            href="/sources"
            hrefLabel="Filter the sources by language"
          />
        )
      }
    </article>

    {
      toc.length > 0 && (
        <nav class="longform__toc" aria-label="On this page">
          <p class="longform__tocHead">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class:list={[h.depth === 3 && 'longform__tocSub']}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>

<style>
  .longform {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: var(--s-7);
    align-items: start;
  }

  .longform__body {
    /* Generous leading for long-form reading. */
    line-height: 1.7;
  }

  .longform__head {
    margin-bottom: var(--s-6);
  }
  .longform__icon {
    font-size: 1.5rem;
    margin: 0 0 var(--s-2);
  }

  /* Tables in the essays are wide and must not push the body sideways. */
  .longform__body :global(table) {
    display: table;
  }
  .longform__body :global(.table-scroll) {
    max-width: none;
  }

  .longform__toc {
    position: sticky;
    top: 5rem;
    border-left: var(--rule);
    padding-left: var(--s-4);
  }
  .longform__tocHead {
    margin: 0 0 var(--s-2);
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .longform__toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }
  .longform__toc a {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--ink-secondary);
    text-decoration: none;
    display: block;
  }
  .longform__toc a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .longform__tocSub a {
    padding-left: var(--s-3);
    color: var(--ink-muted);
  }

  @media (max-width: 64rem) {
    .longform {
      grid-template-columns: 1fr;
    }
    .longform__toc {
      position: static;
      border-left: 0;
      border-top: var(--rule);
      padding-left: 0;
      padding-top: var(--s-3);
      order: -1;
    }
  }
</style>

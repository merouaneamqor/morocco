---
/**
 * The Archive Explorer.
 *
 * Grouped by country by default, which is what makes the Moroccan and Spanish
 * layers fall out without a separate taxonomy: the distribution of holdings
 * across states IS the finding, and grouping by anything else buries it.
 *
 * Each row carries whether a search plan has been written for it. Nineteen of
 * the twenty-five have none, and the page shows that as a count rather than
 * letting a reader assume the coverage is even.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FacetIndex from '../components/FacetIndex.astro';
import { countrySlug } from '../lib/country-slug.mjs';

const archives = (await getCollection('archives')).map((a) => a.data);

const PRIORITY_ORDER = ['1 - decisive', '2 - structural', '3 - supporting', '4 - background'];

const facets = [
  { key: 'country', label: 'Country', values: [...new Set(archives.map((a) => a.country))].sort() },
  {
    key: 'priority',
    label: 'Priority',
    values: PRIORITY_ORDER.filter((p) => archives.some((a) => a.priority === p)),
  },
  { key: 'digitised', label: 'Digitised', values: [...new Set(archives.map((a) => a.digitised))] },
  {
    key: 'verification',
    label: 'Verification',
    values: [...new Set(archives.map((a) => a.verification))],
  },
  {
    key: 'language',
    label: 'Language',
    values: [...new Set(archives.flatMap((a) => a.language))].sort(),
  },
  { key: 'backlog', label: 'Search plan', values: ['Written', 'Not yet documented'] },
];

/** Group by country, countries with decisive holdings first. */
const byCountry = new Map<string, typeof archives>();
for (const a of archives) byCountry.set(a.country, [...(byCountry.get(a.country) ?? []), a]);

const countries = [...byCountry.entries()]
  .map(([country, rows]) => ({
    country,
    slug: countrySlug(country),
    rows: [...rows].sort(
      (a, b) =>
        PRIORITY_ORDER.indexOf(a.priority) - PRIORITY_ORDER.indexOf(b.priority) ||
        a.institution.localeCompare(b.institution)
    ),
    decisive: rows.filter((r) => r.priority === '1 - decisive').length,
  }))
  .sort((a, b) => b.decisive - a.decisive || b.rows.length - a.rows.length);

// The structural finding: the decisive documents are not held in Morocco.
const decisive = archives.filter((a) => a.priority === '1 - decisive');
const decisiveInMorocco = decisive.filter((a) => a.country === 'Morocco');
const withPlan = archives.filter((a) => a.notYetSearched).length;
---

<Base
  title="Archives"
  description="Every holding that bears on Moroccan history — what it can settle, what to search for, and what nobody has searched yet."
>
  <h1>Archives &amp; repositories</h1>

  <p class="lede">
    Grouped by the state that holds them, because the distribution is itself a finding:
    <strong>{decisiveInMorocco.length} of {decisive.length}</strong> decisive holdings are in
    Morocco. A history of Morocco assembled from these archives is, structurally, a history
    of what other states wrote down about it.
  </p>

  <p class="lede lede--backlog">
    <strong>{withPlan} of {archives.length}</strong> holdings have a search plan recorded — what
    to look for and what remains unsearched. The other {archives.length - withPlan} are listed with
    that field marked <em>not yet documented</em>, which means nobody has written the backlog
    down, not that there is nothing left to find.
  </p>

  <FacetIndex facets={facets} countLabel="holdings" />

  {
    countries.map((c) => (
      <section class="country" id={c.slug}>
        <h2>
          <a href={`/archives/country/${c.slug}`}>{c.country}</a>
          <span class="country__count">
            {c.rows.length}
            {c.decisive > 0 && <span class="country__decisive"> · {c.decisive} decisive</span>}
          </span>
        </h2>

        <ul class="rows">
          {c.rows.map((a) => (
            <li
              data-row
              data-country={a.country}
              data-priority={a.priority}
              data-digitised={a.digitised}
              data-verification={a.verification}
              data-language={a.language.join('|')}
              data-backlog={a.notYetSearched ? 'Written' : 'Not yet documented'}
              data-search={`${a.institution} ${a.city ?? ''} ${a.fonds ?? ''} ${a.searchTerms ?? ''}`}
            >
              <div class="rows__head">
                <a href={`/archives/${a.slug}`}>{a.institution}</a>
                <span class="rows__pri" data-pri={a.priority}>
                  {a.priority}
                </span>
              </div>
              {a.whatItCanSettle && <p class="rows__settle">{a.whatItCanSettle}</p>}
              <p class={a.notYetSearched ? 'rows__backlog' : 'rows__backlog rows__backlog--none'}>
                <span class="rows__backloglabel">Not yet searched</span>
                {a.notYetSearched ?? 'Not yet documented'}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .lede {
    max-width: var(--measure);
    color: var(--ink-secondary);
  }

  .lede--backlog {
    padding-top: var(--s-3);
    border-top: var(--rule);
  }

  .country {
    margin-top: var(--s-6);
  }

  .country h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    font-size: 1.1rem;
    border-bottom: 2px solid var(--baseline);
    padding-bottom: var(--s-2);
    margin-bottom: 0;
  }

  .country__count {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .country__decisive {
    color: var(--ink-secondary);
  }

  .rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .rows li {
    padding: var(--s-4) 0;
    border-bottom: var(--rule);
  }

  .rows__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .rows__head a {
    font-size: 1rem;
  }

  .rows__pri {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .rows__pri[data-pri='1 - decisive'] {
    color: var(--ink);
  }

  .rows__settle {
    margin: var(--s-2) 0 0;
    font-size: 0.9rem;
    line-height: var(--leading);
  }

  .rows__backlog {
    margin: var(--s-3) 0 0;
    font-size: 0.85rem;
    line-height: var(--leading);
    color: var(--ink-secondary);
  }

  .rows__backloglabel {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .rows__backlog--none {
    color: var(--ink-muted);
    font-style: italic;
  }
</style>
